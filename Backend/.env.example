# App
APP_NAME="Internal Report Generator"
LOG_LEVEL=INFO
API_PREFIX=/api

# Server used by `python app.py` (migrations run first, then uvicorn starts)
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true

# Database (SQLAlchemy URL, psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/report_generator

# CORS origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Public base URL used to build shareable report links: {PUBLIC_BASE_URL}{API_PREFIX}/reports/{slug}/html
PUBLIC_BASE_URL=http://localhost:3000

# Website reader
SCRAPER_MAX_PAGES=5
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_MAX_BYTES=5000000
SUMMARY_MAX_CHARS=700

# Folder holding the company logos listed in services/exports/themes.py (relative to the Backend folder or absolute)
REPORT_LOGO_DIR=../Frontend/public
REPORT_TIMEZONE=Asia/Kolkata
